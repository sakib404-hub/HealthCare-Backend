model Doctor {
  id String @id @default(uuid())

  name  String
  email String @unique

  specialization  String
  licesnseNumber  String @unique
  qualifications  String
  experienceYears Int

  consultationFee Decimal? @db.Decimal(10, 2)
  bio             String?
  contactNumber   String?

  resume           String?
  resumePublicId  String?

  additionalFiles Json? //? stores both the url and the public id

  verifactionStatus DoctorVerificationStatus @default(PENDING)
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  address           String?

  //? connecting with the user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email], name: "idx_doctor_email")
  @@map("doctors")
}
