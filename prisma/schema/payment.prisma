model Payment {
  id       String        @id @default(uuid())
  status   PaymentStatus @default(UNPAID)
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("BDT")

  //? bkash related information
  paymentGateWay        String  @default("Bkash")
  marchantInvoiceNumber String  @unique //? this will be the appointment id
  bkashPayemtnId        String? @unique
  bkashTransactionId    String?
  payerReference        String? //? user email or the phone number 
  paidAt                String?

  gateWayResponse Json? //? storing the whole bkash response into our database needed for indetail research if any issue comes

  //? when we are refunding the whole amount  
  refundTrxId  String?
  refundAmount Decimal @db.Decimal(10, 2)
  refundReason String?
  refundedAt   String?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
