<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="x-apple-disable-message-reformatting" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<title>Doctor Application Approved - PH Healthcare</title>
	<!--[if mso]>
	<noscript>
		<xml>
			<o:OfficeDocumentSettings>
				<o:PixelsPerInch>96</o:PixelsPerInch>
			</o:OfficeDocumentSettings>
		</xml>
	</noscript>
	<![endif]-->
	<style type="text/css">
		@media only screen and (max-width: 600px) {
			.email-container {
				width: 100% !important;
				margin: 0 !important;
				border-radius: 0 !important;
			}
			.content-cell {
				padding: 24px 20px !important;
			}
			.cta-button {
				width: 100% !important;
				display: block !important;
				box-sizing: border-box !important;
				text-align: center !important;
			}
		}
	</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; color: #334155;">

	<!-- Hidden Preheader for Inbox Snippet -->
	<div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
		Congratulations! Your PH Healthcare doctor application has been approved. Your doctor portal account is now active.
		&#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
	</div>

	<!-- Background Wrapper -->
	<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f5f9; padding: 40px 12px;">
		<tr>
			<td align="center">
				<!-- Email Card -->
				<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);">
					
					<!-- Brand Header -->
					<tr>
						<td style="background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%); padding: 32px 28px; text-align: center;">
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto;">
								<tr>
									<td style="vertical-align: middle; padding-right: 12px;">
										<div style="background-color: rgba(255, 255, 255, 0.2); width: 40px; height: 40px; border-radius: 10px; text-align: center; line-height: 40px; font-size: 22px; color: #ffffff; font-weight: bold; border: 1px solid rgba(255, 255, 255, 0.3);">
											✚
										</div>
									</td>
									<td style="vertical-align: middle; text-align: left;">
										<span style="color: #ffffff; font-size: 22px; font-weight: 700; letter-spacing: 0.5px; display: block; line-height: 1.2;">PH Healthcare</span>
										<span style="color: #ccfbf1; font-size: 11px; font-weight: 600; letter-spacing: 1px; display: block; text-transform: uppercase;">Medical Practitioner & Doctor Portal</span>
									</td>
								</tr>
							</table>
						</td>
					</tr>

					<!-- Subheader Badge Bar -->
					<tr>
						<td style="background-color: #ecfdf5; border-bottom: 1px solid #a7f3d0; padding: 10px 24px; text-align: center;">
							<span style="font-size: 12px; font-weight: 700; color: #065f46; letter-spacing: 0.5px; text-transform: uppercase; display: inline-flex; align-items: center;">
								✅ Application Approved &bull; Credentials Verified
							</span>
						</td>
					</tr>

					<!-- Content Body -->
					<tr>
						<td class="content-cell" style="padding: 36px 32px 24px 32px;">
							<h1 style="margin: 0 0 16px 0; font-size: 22px; font-weight: 700; color: #0f172a; letter-spacing: -0.2px;">
								Welcome to the PH Healthcare Medical Team!
							</h1>
							
							<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #475569;">
								Dear <%= (typeof name !== 'undefined' && name) ? (name.trim().toLowerCase().startsWith('dr') ? name.trim() : 'Dr. ' + name.trim()) : 'Doctor' %>,
							</p>

							<p style="margin: 0 0 20px 0; font-size: 15px; line-height: 1.6; color: #475569;">
								We are pleased to inform you that your doctor application has been <strong>successfully reviewed and approved</strong> by the PH Healthcare Medical Credentialing Committee.
							</p>

							<!-- Approval Showcase Card -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0 28px 0;">
								<tr>
									<td align="center">
										<div style="background-color: #f0fdf4; border: 2px solid #86efac; border-radius: 12px; padding: 24px 28px; text-align: center; max-width: 100%; box-sizing: border-box;">
											<div style="width: 48px; height: 48px; background-color: #dcfce7; border-radius: 50%; margin: 0 auto 12px auto; line-height: 48px; font-size: 26px;">
												🩺
											</div>
											<div style="font-size: 16px; font-weight: 700; color: #15803d; letter-spacing: 0.3px; margin-bottom: 6px;">
												Official Medical Practitioner Status
											</div>
											<div style="font-size: 13px; color: #475569; line-height: 1.5;">
												Your profile is now verified and active in the PH Healthcare provider network.
											</div>
										</div>
									</td>
								</tr>
							</table>

							<!-- Step-by-Step Next Steps -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; margin: 0 0 28px 0;">
								<tr>
									<td style="padding: 20px 22px;">
										<div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
											Getting Started as a PH Healthcare Doctor:
										</div>
										<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 13px; line-height: 1.6; color: #475569;">
											<tr>
												<td style="vertical-align: top; width: 24px; color: #0d9488; font-weight: 700;">1.</td>
												<td style="vertical-align: top; padding-bottom: 10px;">
													<strong>Sign In to Your Doctor Dashboard:</strong> Log in using your registered email and credentials.
												</td>
											</tr>
											<tr>
												<td style="vertical-align: top; width: 24px; color: #0d9488; font-weight: 700;">2.</td>
												<td style="vertical-align: top; padding-bottom: 10px;">
													<strong>Configure Your Availability & Schedules:</strong> Define your consultation hours, appointment durations, and weekly shifts.
												</td>
											</tr>
											<tr>
												<td style="vertical-align: top; width: 24px; color: #0d9488; font-weight: 700;">3.</td>
												<td style="vertical-align: top; padding-bottom: 10px;">
													<strong>Review Professional Details:</strong> Ensure your biography, specialties, and consultation fees are accurate.
												</td>
											</tr>
											<tr>
												<td style="vertical-align: top; width: 24px; color: #0d9488; font-weight: 700;">4.</td>
												<td style="vertical-align: top;">
													<strong>Start Receiving Consultations:</strong> Begin managing patient appointments and online prescriptions.
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</table>

							<!-- Call to Action Button -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 28px 0;">
								<tr>
									<td align="center">
										<a href="<%= (typeof loginUrl !== 'undefined' && loginUrl) ? loginUrl : ((typeof dashboardUrl !== 'undefined' && dashboardUrl) ? dashboardUrl : 'http://localhost:3000/login') %>" class="cta-button" style="display: inline-block; background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%); color: #ffffff; text-decoration: none; font-weight: 600; font-size: 15px; padding: 14px 36px; border-radius: 8px; box-shadow: 0 2px 8px rgba(15, 118, 110, 0.25);">
											Access Doctor Portal &rarr;
										</a>
									</td>
								</tr>
							</table>

							<!-- Confidentiality & Security Notice -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f0fdfa; border: 1px solid #ccfbf1; border-left: 4px solid #0d9488; border-radius: 8px; margin: 0 0 20px 0;">
								<tr>
									<td style="padding: 14px 16px;">
										<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
											<tr>
												<td style="vertical-align: top; width: 24px; font-size: 16px; color: #0d9488; line-height: 1.4;">
													🛡️
												</td>
												<td style="vertical-align: top; padding-left: 8px; font-size: 13px; line-height: 1.5; color: #134e4a;">
													<strong>Compliance Reminder:</strong> As an accredited healthcare provider on PH Healthcare, all medical consultations, patient history records, and prescriptions are subject to strict healthcare confidentiality and data protection standards.
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</table>

							<p style="margin: 24px 0 0 0; font-size: 13px; line-height: 1.5; color: #94a3b8;">
								If you need assistance setting up your doctor profile or have questions, please reach out to our provider relations team at <a href="mailto:support@phhealthcare.com" style="color: #0d9488; text-decoration: none; font-weight: 600;">support@phhealthcare.com</a>.
							</p>
						</td>
					</tr>

					<!-- Divider -->
					<tr>
						<td style="padding: 0 32px;">
							<div style="height: 1px; background-color: #f1f5f9; width: 100%;"></div>
						</td>
					</tr>

					<!-- Compliance & Corporate Footer -->
					<tr>
						<td style="padding: 24px 32px 32px 32px; text-align: center; font-size: 12px; line-height: 1.6; color: #94a3b8;">
							<p style="margin: 0 0 6px 0;">
								This is an automated administrative notification sent from the <strong>PH Healthcare Credentialing System</strong>.
							</p>
							<p style="margin: 0 0 8px 0;">
								Please do not reply directly to this email as incoming messages to this address are not monitored.
							</p>
							<p style="margin: 0; color: #cbd5e1;">
								&copy; <%= new Date().getFullYear() %> PH Healthcare, Inc. All rights reserved.
							</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>