<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="x-apple-disable-message-reformatting" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<title>Welcome to PH Healthcare - Google Sign-In</title>
	<!--[if mso]>
	<noscript>
		<xml>
			<o:OfficeDocumentSettings>
				<o:PixelsPerInch>96</o:PixelsPerInch>
			</o:OfficeDocumentSettings>
		</xml>
	</noscript>
	<![endif]-->
	<style type="text/css">
		@media only screen and (max-width: 600px) {
			.email-container {
				width: 100% !important;
				margin: 0 !important;
				border-radius: 0 !important;
			}
			.content-cell {
				padding: 24px 20px !important;
			}
			.cta-button {
				width: 100% !important;
				display: block !important;
				box-sizing: border-box !important;
				text-align: center !important;
			}
		}
	</style>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; color: #334155;">

	<!-- Hidden Preheader for Inbox Snippet -->
	<div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
		Welcome to PH Healthcare! You have successfully signed in with your Google account. Your patient account is now active.
		&#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy; &#847; &zwnj; &nbsp; &#8199; &shy;
	</div>

	<!-- Background Wrapper -->
	<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f5f9; padding: 40px 12px;">
		<tr>
			<td align="center">
				<!-- Email Card -->
				<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 560px; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);">
					
					<!-- Brand Header -->
					<tr>
						<td style="background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%); padding: 32px 24px; text-align: center;">
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto;">
								<tr>
									<td style="vertical-align: middle; padding-right: 10px;">
										<div style="background-color: rgba(255, 255, 255, 0.2); width: 36px; height: 36px; border-radius: 8px; text-align: center; line-height: 36px; font-size: 20px; color: #ffffff; font-weight: bold;">
											✚
										</div>
									</td>
									<td style="vertical-align: middle; text-align: left;">
										<span style="color: #ffffff; font-size: 22px; font-weight: 700; letter-spacing: 0.5px; display: block; line-height: 1.2;">PH Healthcare</span>
										<span style="color: #ccfbf1; font-size: 12px; letter-spacing: 0.5px; display: block;">PATIENT & DOCTOR PORTAL</span>
									</td>
								</tr>
							</table>
						</td>
					</tr>

					<!-- Content Body -->
					<tr>
						<td class="content-cell" style="padding: 36px 32px 24px 32px;">
							<h1 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 700; color: #0f172a; letter-spacing: -0.2px;">
								Welcome to PH Healthcare! 🎉
							</h1>
							
							<p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #475569;">
								Hello<%= (typeof name !== 'undefined' && name) ? ' ' + name : '' %>,
							</p>

							<p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #475569;">
								Thank you for choosing <strong>PH Healthcare</strong>. You have successfully signed up and logged in for the first time using your Google account. Your patient account has been created and is now active and ready to use.
							</p>

							<!-- Status Showcase Card -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0 28px 0;">
								<tr>
									<td align="center">
										<div style="background-color: #f0fdfa; border: 2px dashed #0d9488; border-radius: 12px; padding: 22px 32px; display: inline-block; text-align: center; max-width: 420px; width: 100%; box-sizing: border-box;">
											<div style="font-size: 36px; line-height: 1; margin-bottom: 10px;">
												🌐
											</div>
											<div style="font-size: 17px; font-weight: 700; color: #0f766e; letter-spacing: 0.3px;">
												Google Sign-In Connected
											</div>
											<div style="margin-top: 6px; font-size: 13px; color: #64748b;">
												Your account is verified and ready for seamless access
											</div>
										</div>
									</td>
								</tr>
							</table>

							<!-- Account Details Summary -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; margin: 0 0 28px 0;">
								<tr>
									<td style="padding: 18px 20px;">
										<div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #0f766e; margin-bottom: 12px;">
											Account Summary
										</div>
										<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 13px; line-height: 1.8; color: #475569;">
											<tr>
												<td style="width: 140px; color: #64748b; vertical-align: top;">Name:</td>
												<td style="font-weight: 600; color: #0f172a; vertical-align: top;"><%= typeof name !== 'undefined' && name ? name : 'N/A' %></td>
											</tr>
											<tr>
												<td style="color: #64748b; vertical-align: top;">Email:</td>
												<td style="font-weight: 600; color: #0f172a; vertical-align: top;"><%= typeof email !== 'undefined' && email ? email : 'N/A' %></td>
											</tr>
											<tr>
												<td style="color: #64748b; vertical-align: top;">Sign-In Method:</td>
												<td style="font-weight: 600; color: #0f172a; vertical-align: top;">Google Authentication (OAuth)</td>
											</tr>
											<tr>
												<td style="color: #64748b; vertical-align: top;">Account Status:</td>
												<td style="vertical-align: top;">
													<span style="display: inline-block; background-color: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9999px;">
														ACTIVE
													</span>
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</table>

							<!-- What You Can Do Section -->
							<div style="margin-bottom: 24px;">
								<h2 style="margin: 0 0 12px 0; font-size: 15px; font-weight: 700; color: #0f172a;">
									What you can do now:
								</h2>
								<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 13px; line-height: 1.6; color: #475569;">
									<tr>
										<td style="vertical-align: top; width: 24px; font-size: 16px; padding-bottom: 10px;">🩺</td>
										<td style="vertical-align: top; padding-left: 8px; padding-bottom: 10px;">
											<strong>Book Appointments:</strong> Browse specialists by department and schedule your appointments with ease.
										</td>
									</tr>
									<tr>
										<td style="vertical-align: top; width: 24px; font-size: 16px; padding-bottom: 10px;">📋</td>
										<td style="vertical-align: top; padding-left: 8px; padding-bottom: 10px;">
											<strong>Medical Records:</strong> Safely view and store your prescriptions, reports, and doctor notes anytime.
										</td>
									</tr>
									<tr>
										<td style="vertical-align: top; width: 24px; font-size: 16px;">⚡</td>
										<td style="vertical-align: top; padding-left: 8px;">
											<strong>Fast & Passwordless:</strong> Next time you visit, simply click <em>"Continue with Google"</em> for instant, secure sign-in.
										</td>
									</tr>
								</table>
							</div>

							<!-- Action Button -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 28px 0 28px 0;">
								<tr>
									<td align="center">
										<a href="<%= (typeof loginUrl !== 'undefined' && loginUrl) ? loginUrl : '#' %>" class="cta-button" style="display: inline-block; background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%); color: #ffffff; text-decoration: none; font-weight: 600; font-size: 15px; padding: 13px 32px; border-radius: 8px; box-shadow: 0 2px 8px rgba(15, 118, 110, 0.25);">
											Go to Patient Portal &rarr;
										</a>
									</td>
								</tr>
							</table>

							<!-- Security Notice Box -->
							<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fef2f2; border: 1px solid #fee2e2; border-left: 4px solid #ef4444; border-radius: 8px; margin: 20px 0 16px 0;">
								<tr>
									<td style="padding: 14px 16px;">
										<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
											<tr>
												<td style="vertical-align: top; width: 22px; font-size: 15px; color: #ef4444; line-height: 1.4;">
													🛡️
												</td>
												<td style="vertical-align: top; padding-left: 8px; font-size: 13px; line-height: 1.5; color: #991b1b;">
													<strong>Security Alert:</strong> This email confirms a new sign-in to PH Healthcare using your Google account. If you did not authorize this action or do not recognize this activity, please contact our security team immediately at <a href="mailto:support@phhealthcare.com" style="color: #991b1b; font-weight: 700; text-decoration: underline;">support@phhealthcare.com</a>.
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</table>

							<p style="margin: 24px 0 0 0; font-size: 13px; line-height: 1.5; color: #94a3b8;">
								Need assistance? Our support team is always available to help at <a href="mailto:support@phhealthcare.com" style="color: #0d9488; text-decoration: none; font-weight: 500;">support@phhealthcare.com</a>.
							</p>
						</td>
					</tr>

					<!-- Divider -->
					<tr>
						<td style="padding: 0 32px;">
							<div style="height: 1px; background-color: #f1f5f9; width: 100%;"></div>
						</td>
					</tr>

					<!-- Compliance & Corporate Footer -->
					<tr>
						<td style="padding: 24px 32px 32px 32px; text-align: center; font-size: 12px; line-height: 1.6; color: #94a3b8;">
							<p style="margin: 0 0 6px 0;">
								This is an automated administrative notification sent from <strong>PH Healthcare System</strong>.
							</p>
							<p style="margin: 0 0 8px 0;">
								Please do not reply directly to this email as this inbox is unmonitored.
							</p>
							<p style="margin: 0; color: #cbd5e1;">
								&copy; <%= new Date().getFullYear() %> PH Healthcare, Inc. All rights reserved.
							</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>
